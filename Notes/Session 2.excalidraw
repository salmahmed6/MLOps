      "link": null,
      "locked": false,
      "text": "Ruff --> find bad code\n            it is a linter\n            looks for problem\nBlack --> format code\n            make python follow a consistent format\npre-commit --> automatically run checks\nterraform --> infrastructure as code\n                describe your infra in code and terraform create it for you\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ruff --> find bad code\n            it is a linter\n            looks for problem\nBlack --> format code\n            make python follow a consistent format\npre-commit --> automatically run checks\nterraform --> infrastructure as code\n                describe your infra in code and terraform create it for you\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
