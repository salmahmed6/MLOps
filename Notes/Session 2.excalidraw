      "isDeleted": false,
      "boundElements": [],
      "updated": 1787604689392,
      "link": null,
      "locked": false,
      "text": "ml_project/\n│\n├── src/\n│   ├── __init__.py\n│   ├── model.py\n│   ├── pipeline.py\n│   └── utils.py\n│\n├── tests/\n│   └── test_model.py\n│\n├── configs/\n│   └── config.yaml\n│\n├── notebooks/\n│   └── exploration.ipynb\n│\n├── Dockerfile\n├── pyproject.toml\n└── README.md",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ml_project/\n│\n├── src/\n│   ├── __init__.py\n│   ├── model.py\n│   ├── pipeline.py\n│   └── utils.py\n│\n├── tests/\n│   └── test_model.py\n│\n├── configs/\n│   └── config.yaml\n│\n├── notebooks/\n│   └── exploration.ipynb\n│\n├── Dockerfile\n├── pyproject.toml\n└── README.md",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
