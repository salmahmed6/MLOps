    {
      "id": "6AgaVe0Sn2VNcfMOat0yu",
      "type": "text",
      "x": -4960.912698412698,
      "y": 1823.0555555555552,
      "width": 571.9396362304688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 1534868211,
      "version": 91,
      "versionNonce": 1424423123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787606000979,
      "link": null,
      "locked": false,
      "text": "How does data/model information travel between systems?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How does data/model information travel between systems?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8OaGpwj-VCN-dL35fZzfn",
      "type": "text",
      "x": -4936.912698412698,
      "y": 1878.0555555555552,
      "width": 662.6195068359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 2070512797,
      "version": 143,
      "versionNonce": 1515251283,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787606147179,
      "link": null,
      "locked": false,
      "text": "Serialization means converting data/object information into a formt\nthat can be stored or transmitted\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serialization means converting data/object information into a formt\nthat can be stored or transmitted\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qaDA1NvWZf1A0rI5K0byu",
      "type": "text",
      "x": -4911.912698412698,
      "y": 1943.0555555555552,
      "width": 584.299560546875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1u",
      "roundness": null,
      "seed": 1252933501,
      "version": 104,
      "versionNonce": 304059795,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787606152554,
      "link": null,
      "locked": false,
      "text": "| Format      | Type   | Main use                         \n| ----------- | ------ | --------------------------------- \n| JSON        | Text   | REST APIs, configs, logs         \n| MessagePack | Binary | High-throughput communication     \n| Protobuf    | Binary | gRPC/streaming                    \n| Pickle      | Binary | Python-only model files           \n| ONNX        | Binary | Cross-framework model portability \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Format      | Type   | Main use                         \n| ----------- | ------ | --------------------------------- \n| JSON        | Text   | REST APIs, configs, logs         \n| MessagePack | Binary | High-throughput communication     \n| Protobuf    | Binary | gRPC/streaming                    \n| Pickle      | Binary | Python-only model files           \n| ONNX        | Binary | Cross-framework model portability \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xehInuWmHHeKcckw9Q75X",
      "type": "text",
      "x": -4927.912698412698,
      "y": 2155.055555555555,
      "width": 784.9593505859375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 766556595,
      "version": 185,
      "versionNonce": 1662000061,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787644244450,
      "link": null,
      "locked": false,
      "text": "Note: pickle is  convenient in python but never expose arbitrary/untrusted pickle\n        files throught an API\nwhy? because deserializing untrusted pickle data can be dangerous\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: pickle is  convenient in python but never expose arbitrary/untrusted pickle\n        files throught an API\nwhy? because deserializing untrusted pickle data can be dangerous\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
