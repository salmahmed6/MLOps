      "versionNonce": 171047475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787602807327,
      "link": null,
      "locked": false,
      "text": "α ( alpha) = learning rate\n             = controls how big each step is\n             = step size\n            \nderivative = tell graident descent which direction to move\n             = direction of slope\n\n",
      "fontSize": 19.9,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "α ( alpha) = learning rate\n             = controls how big each step is\n             = step size\n            \nderivative = tell graident descent which direction to move\n             = direction of slope\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "V71iZZJK5pOoCZqyrdG2Z",
