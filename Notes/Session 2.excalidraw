    {
      "id": "4ZU8d2xAjpgaEr2zaknOE",
      "type": "text",
      "x": -5061.912698412698,
      "y": 1445.0555555555552,
      "width": 656.5595703125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 2012648797,
      "version": 378,
      "versionNonce": 1176161533,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "LFMskD3FKz_jC6qkJUqIT",
          "type": "arrow"
        }
      ],
      "updated": 1787605855716,
      "link": null,
      "locked": false,
      "text": "we have 6 important requirements:\n    1- input validation\n    2-health endpoint\n    3-load model once (don't reload on every request)\n    4- Async handlers which helps with concurrent request handling\n    5- response schema\n    6- documentation which make ths API easy to inspect and test\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we have 6 important requirements:\n    1- input validation\n    2-health endpoint\n    3-load model once (don't reload on every request)\n    4- Async handlers which helps with concurrent request handling\n    5- response schema\n    6- documentation which make ths API easy to inspect and test\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
