      "boundElements": [],
      "updated": 1787682552437,
      "link": null,
      "locked": false,
      "text": "ONNX:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONNX:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "uVtyyePYSUbQkePrvtW1x",
      "type": "text",
      "x": -4922.531746031743,
      "y": 2349.7063492063517,
      "width": 776.439453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 2084416563,
      "version": 390,
      "versionNonce": 772589149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787682965738,
      "link": null,
      "locked": false,
      "text": "ONNX = Open Neural Network Exchange\n-think it as a portable model representation\n-the important idea is Training framework != production runtime necessarily\n- you don't need the entire pyTorch environment in production\n-in smaller production env you can potentially remove large training dependencies\n-onnx runtime can use execution providers \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONNX = Open Neural Network Exchange\n-think it as a portable model representation\n-the important idea is Training framework != production runtime necessarily\n- you don't need the entire pyTorch environment in production\n-in smaller production env you can potentially remove large training dependencies\n-onnx runtime can use execution providers \n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "q95Nwm5Vy8x4myy6bZTw-",
      "type": "text",
      "x": -4971.420634920632,
      "y": 2518.5952380952403,
      "width": 260.7398681640625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": null,
      "seed": 212957491,
      "version": 100,
      "versionNonce": 743257427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787683030886,
      "link": null,
      "locked": false,
      "text": "When should we use ONNX?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When should we use ONNX?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "u4cp22leibB6VxpqznsEl",
      "type": "text",
      "x": -4922.531746031743,
      "y": 2553.0396825396847,
      "width": 499.5596618652344,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 1440796765,
      "version": 46,
      "versionNonce": 125078013,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787683079006,
      "link": null,
      "locked": false,
      "text": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GsgtzoBYD5cBkFBSjbG9v",
      "type": "text",
      "x": -4965.865079365076,
      "y": 2723.0396825396847,
      "width": 226.9598388671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b26",
      "roundness": null,
      "seed": 574295837,
      "version": 54,
      "versionNonce": 1193595837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787683097049,
      "link": null,
      "locked": false,
      "text": "When might we skip it? ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When might we skip it? ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2PL5Zkpvo9IrHvMfJNHGw",
      "type": "text",
      "x": -4928.087301587299,
      "y": 2763.039682539685,
      "width": 440.4196472167969,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b28",
      "roundness": null,
      "seed": 929866397,
      "version": 24,
      "versionNonce": 476159997,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787683146727,
      "link": null,
      "locked": false,
      "text": "Already serving comfortably in Python\nCustom unsupported operations\nNeed continuous fine-tuning of same artifact\nModel changes extremely frequently\nCurrent latency already satisfies SLA",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Already serving comfortably in Python\nCustom unsupported operations\nNeed continuous fine-tuning of same artifact\nModel changes extremely frequently\nCurrent latency already satisfies SLA",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
