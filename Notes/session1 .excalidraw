      "roundness": null,
      "seed": 574295837,
      "version": 54,
      "versionNonce": 1193595837,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787683097049,
      "link": null,
      "locked": false,
      "text": "When might we skip it? ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When might we skip it? ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qXsfNZa1qSuEQNZvJOpZW",
      "type": "text",
      "x": -4901.4206349206315,
      "y": 2783.039682539685,
      "width": 499.5596618652344,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b27",
      "roundness": null,
      "seed": 1760761715,
      "version": 52,
      "versionNonce": 817550131,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1787683119487,
      "link": null,
      "locked": false,
      "text": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2PL5Zkpvo9IrHvMfJNHGw",
      "type": "text",
      "x": -4928.087301587299,
      "y": 2763.039682539685,
      "width": 440.4196472167969,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b28",
      "roundness": null,
      "seed": 929866397,
      "version": 24,
      "versionNonce": 476159997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787683146727,
      "link": null,
      "locked": false,
      "text": "Already serving comfortably in Python\nCustom unsupported operations\nNeed continuous fine-tuning of same artifact\nModel changes extremely frequently\nCurrent latency already satisfies SLA",
      "fontSize": 20,
