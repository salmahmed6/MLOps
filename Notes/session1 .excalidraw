    {
      "id": "u4cp22leibB6VxpqznsEl",
      "type": "text",
      "x": -4922.531746031743,
      "y": 2553.0396825396847,
      "width": 499.5596618652344,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 1440796765,
      "version": 46,
      "versionNonce": 125078013,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787683079006,
      "link": null,
      "locked": false,
      "text": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Need C++/Java/etc.\nNeed browser/edge deployment\nNeed mobile/embedded deployment\nNeed hardware acceleration\nWant to remove training framework from production\nMultiple teams/languages need the model",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GsgtzoBYD5cBkFBSjbG9v",
      "type": "text",
      "x": -4965.865079365076,
      "y": 2723.0396825396847,
      "width": 226.9598388671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
